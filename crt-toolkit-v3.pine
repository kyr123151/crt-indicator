//@version=6
indicator("CRT Toolkit v3", overlay = true, max_lines_count = 300, max_boxes_count = 300, max_labels_count = 300)

// =====================================================================
// INPUTS
// =====================================================================
gTf = "Timeframes"
on1 = input.bool(true, "Slot 1", inline = "s1", group = gTf)
tf1 = input.timeframe("30", "", inline = "s1", group = gTf)
on2 = input.bool(true, "Slot 2", inline = "s2", group = gTf)
tf2 = input.timeframe("60", "", inline = "s2", group = gTf)
on3 = input.bool(true, "Slot 3", inline = "s3", group = gTf)
tf3 = input.timeframe("240", "", inline = "s3", group = gTf)

gFl = "Filters"
useWick    = input.bool(true, "Mother wick filter", group = gFl)
maxWick    = input.float(70.0, "Max wick % of body", minval = 0.0, step = 5.0, group = gFl)
useQuality = input.bool(true, "Quality only (child closes past 50%, wick short of TP2)", group = gFl)
failPct    = input.float(30.0, "Failed level (% of range beyond sweep)", minval = 1.0, group = gFl)

gVis = "Visuals"
bullCol    = input.color(#00e5a0, "Bull color", group = gVis)
bearCol    = input.color(#ff4d6d, "Bear color", group = gVis)
showBox    = input.bool(true, "Shaded range box", group = gVis)
showLabels = input.bool(true, "Signal labels", group = gVis)
showRight  = input.bool(true, "Right-side level labels", group = gVis)
showManip  = input.bool(true, "Manipulation zone", group = gVis)
manipCol   = input.color(color.new(#ffb300, 80), "Manipulation zone color", group = gVis)
showCandle = input.bool(true, "HTF candle + countdown (active setups)", group = gVis)
showTable  = input.bool(true, "Dashboard", group = gVis)

gFvg = "FVG"
showFvg = input.bool(true, "Show FVG", group = gFvg)
fvgMin  = input.float(30.0, "Min FVG size (% of ATR14)", minval = 0.0, group = gFvg)
fvgMax  = input.int(15, "Max FVG boxes", minval = 1, maxval = 60, group = gFvg)
fvgBull = input.color(color.new(#2962ff, 85), "Bull FVG", group = gFvg)
fvgBear = input.color(color.new(#9c27b0, 85), "Bear FVG", group = gFvg)

// =====================================================================
// TYPE
// =====================================================================
type Setup
    int dir = 0
    bool hit1 = false
    float hi = na
    float lo = na
    float tp1 = na
    float tp2 = na
    float failLvl = na
    line lHi = na
    line lLo = na
    line lMid = na
    line lFail = na
    box rBox = na
    box manip = na
    bool manipOpen = false
    int mDir = 0
    float mEdge = na
    box cBody = na
    line cWick = na
    label lbHi = na
    label lbLo = na
    label lbTp1 = na
    label lbFail = na
    label lbCd = na
    int nSig = 0
    int nTp1 = 0
    int nTp2 = 0
    int nFail = 0
    string lastRes = "-"

// =====================================================================
// HELPERS
// =====================================================================
tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string res = str.tostring(int(sec / 60)) + "m"
    if sec >= 86400
        res := str.tostring(int(sec / 86400)) + "D"
    else if sec >= 3600
        res := str.tostring(int(sec / 3600)) + "H"
    res

// [1] = child candle that just closed, [2] = mother candle (no lookahead)
crtData(string tf) =>
    [o1, h1, l1, c1, o2, h2, l2, c2, t1, t2, lo, hh, ll, lc] = request.security(syminfo.tickerid, tf, [open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2], time[1], time[2], open, high, low, close], lookahead = barmerge.lookahead_off)
    bool newHtf = ta.change(time(tf)) != 0
    float body = math.abs(c2 - o2)
    float upW = h2 - math.max(o2, c2)
    float loW = math.min(o2, c2) - l2
    bool wickOk = not useWick or (body > 0 and upW <= body * maxWick / 100 and loW <= body * maxWick / 100)
    float mid = (h2 + l2) / 2
    bool bullQ = not useQuality or (c1 > mid and h1 < h2)
    bool bearQ = not useQuality or (c1 < mid and l1 > l2)
    bool isBull = newHtf and wickOk and l1 < l2 and h1 <= h2 and c1 > l2 and c1 < h2 and bullQ
    bool isBear = newHtf and wickOk and h1 > h2 and l1 >= l2 and c1 < h2 and c1 > l2 and bearQ
    [isBull, isBear, h1, l1, h2, l2, t1, t2, lo, hh, ll, lc]

process(Setup s, bool en, string lbl, bool isBull, bool isBear, float h1, float l1, float h2, float l2, int t1, int t2) =>
    if en
        bool newSig = isBull or isBear
        bool closeNow = false

        if s.manipOpen and not newSig
            bool touched = s.mDir == 1 ? low <= s.mEdge : high >= s.mEdge
            box.set_right(s.manip, time)
            if touched
                s.manipOpen := false

        if s.dir != 0
            if newSig
                closeNow := true
                s.lastRes := s.hit1 ? "TP1 ok" : "Replaced"
            else
                bool failed = s.dir == 1 ? low <= s.failLvl : high >= s.failLvl
                if failed
                    s.nFail := s.nFail + 1
                    s.lastRes := s.hit1 ? "TP1 ok > Failed" : "Failed"
                    closeNow := true
                else
                    bool r1 = s.dir == 1 ? high >= s.tp1 : low <= s.tp1
                    bool r2 = s.dir == 1 ? high >= s.tp2 : low <= s.tp2
                    if r1 and not s.hit1
                        s.hit1 := true
                        s.nTp1 := s.nTp1 + 1
                    if r2
                        s.nTp2 := s.nTp2 + 1
                        s.lastRes := "TP2 Done"
                        closeNow := true

        if closeNow
            line.set_x2(s.lHi, time)
            line.set_extend(s.lHi, extend.none)
            line.set_x2(s.lLo, time)
            line.set_extend(s.lLo, extend.none)
            line.set_x2(s.lMid, time)
            line.set_extend(s.lMid, extend.none)
            line.set_x2(s.lFail, time)
            line.set_extend(s.lFail, extend.none)
            box.set_right(s.rBox, time)
            s.dir := 0

        if s.dir != 0
            box.set_right(s.rBox, time)

        if newSig
            float rng = h2 - l2
            color col = isBull ? bullCol : bearCol
            s.dir := isBull ? 1 : -1
            s.hit1 := false
            s.nSig := s.nSig + 1
            s.hi := h2
            s.lo := l2
            s.tp1 := (h2 + l2) / 2
            s.tp2 := isBull ? h2 : l2
            s.failLvl := isBull ? l2 - failPct / 100 * rng : h2 + failPct / 100 * rng
            s.lHi := line.new(t2, h2, time, h2, xloc = xloc.bar_time, extend = extend.right, color = col, width = 1)
            s.lLo := line.new(t2, l2, time, l2, xloc = xloc.bar_time, extend = extend.right, color = col, width = 1)
            s.lMid := line.new(t2, s.tp1, time, s.tp1, xloc = xloc.bar_time, extend = extend.right, color = color.new(col, 50), style = line.style_dotted)
            s.lFail := line.new(t2, s.failLvl, time, s.failLvl, xloc = xloc.bar_time, extend = extend.right, color = color.new(color.gray, 30), style = line.style_dashed)
            if showBox
                s.rBox := box.new(t2, h2, time, l2, xloc = xloc.bar_time, border_color = na, bgcolor = color.new(col, 92))
            if showManip
                s.mDir := s.dir
                if isBull
                    s.mEdge := l2
                    s.manip := box.new(t1, l2, time, l1, xloc = xloc.bar_time, border_color = na, bgcolor = manipCol, text = "Manipulation", text_size = size.tiny, text_color = color.gray)
                else
                    s.mEdge := h2
                    s.manip := box.new(t1, h1, time, h2, xloc = xloc.bar_time, border_color = na, bgcolor = manipCol, text = "Manipulation", text_size = size.tiny, text_color = color.gray)
                s.manipOpen := true
            if showLabels
                string dirTxt = isBull ? "BULL CRT " : "BEAR CRT "
                label.new(time, isBull ? l2 : h2, dirTxt + lbl, xloc = xloc.bar_time, style = isBull ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small)
            string msg = "CRT " + lbl + (isBull ? " BULL | " : " BEAR | ") + syminfo.ticker + "\nTP1 (50%): " + str.tostring(s.tp1, format.mintick) + "\nTP2: " + str.tostring(s.tp2, format.mintick)
            alert(msg, alert.freq_once_per_bar_close)
    true

// Right-side labels + live HTF candle with countdown (drawn on the last bar only)
drawRight(Setup s, bool en, string lbl, int tc, float lo, float hh, float ll, float lc, int slot) =>
    if barstate.islast
        box.delete(s.cBody)
        line.delete(s.cWick)
        label.delete(s.lbHi)
        label.delete(s.lbLo)
        label.delete(s.lbTp1)
        label.delete(s.lbFail)
        label.delete(s.lbCd)
        if en and s.dir != 0
            color col = s.dir == 1 ? bullCol : bearCol
            color clear = color.new(color.white, 100)
            int xl = bar_index + 2
            if showRight
                string hiTxt = "CRH " + lbl + (s.dir == 1 ? " | TP2" : "")
                string loTxt = "CRL " + lbl + (s.dir == -1 ? " | TP2" : "")
                s.lbHi := label.new(xl, s.hi, hiTxt, style = label.style_label_left, color = clear, textcolor = col, size = size.small)
                s.lbLo := label.new(xl, s.lo, loTxt, style = label.style_label_left, color = clear, textcolor = col, size = size.small)
                s.lbTp1 := label.new(xl, s.tp1, "TP1 50%", style = label.style_label_left, color = clear, textcolor = color.gray, size = size.small)
                s.lbFail := label.new(xl, s.failLvl, "FAIL", style = label.style_label_left, color = clear, textcolor = color.gray, size = size.small)
            if showCandle
                color cc = lc >= lo ? bullCol : bearCol
                int x0 = bar_index + 14 + slot * 4
                s.cBody := box.new(x0, math.max(lo, lc), x0 + 2, math.min(lo, lc), border_color = cc, bgcolor = color.new(cc, 60))
                s.cWick := line.new(x0 + 1, hh, x0 + 1, ll, color = cc)
                int mins = na(tc) ? 0 : math.max(0, int((tc - timenow) / 60000))
                s.lbCd := label.new(x0 + 1, hh, lbl + " [" + str.tostring(mins) + "m left]", style = label.style_label_down, color = clear, textcolor = color.silver, size = size.tiny)
    true

// =====================================================================
// STATE + DATA
// =====================================================================
var Setup s1 = Setup.new()
var Setup s2 = Setup.new()
var Setup s3 = Setup.new()

valid1 = timeframe.in_seconds() <= timeframe.in_seconds(tf1)
valid2 = timeframe.in_seconds() <= timeframe.in_seconds(tf2)
valid3 = timeframe.in_seconds() <= timeframe.in_seconds(tf3)
en1 = on1 and valid1
en2 = on2 and valid2
en3 = on3 and valid3

tc1 = time_close(tf1)
tc2 = time_close(tf2)
tc3 = time_close(tf3)

[bull1, bear1, h1a, l1a, h2a, l2a, t1a, t2a, loA, hhA, llA, lcA] = crtData(tf1)
[bull2, bear2, h1b, l1b, h2b, l2b, t1b, t2b, loB, hhB, llB, lcB] = crtData(tf2)
[bull3, bear3, h1c, l1c, h2c, l2c, t1c, t2c, loC, hhC, llC, lcC] = crtData(tf3)

process(s1, en1, tfName(tf1), bull1, bear1, h1a, l1a, h2a, l2a, t1a, t2a)
process(s2, en2, tfName(tf2), bull2, bear2, h1b, l1b, h2b, l2b, t1b, t2b)
process(s3, en3, tfName(tf3), bull3, bear3, h1c, l1c, h2c, l2c, t1c, t2c)

drawRight(s1, en1, tfName(tf1), tc1, loA, hhA, llA, lcA, 0)
drawRight(s2, en2, tfName(tf2), tc2, loB, hhB, llB, lcB, 1)
drawRight(s3, en3, tfName(tf3), tc3, loC, hhC, llC, lcC, 2)

anyBull = (bull1 and en1) or (bull2 and en2) or (bull3 and en3)
anyBear = (bear1 and en1) or (bear2 and en2) or (bear3 and en3)
plotshape(anyBull, title = "Bull signal", style = shape.triangleup, location = location.belowbar, color = bullCol, size = size.tiny)
plotshape(anyBear, title = "Bear signal", style = shape.triangledown, location = location.abovebar, color = bearCol, size = size.tiny)

// =====================================================================
// FVG (chart timeframe) - removed as soon as price fills them
// =====================================================================
var array<box> fvgBoxes = array.new<box>()
var array<int> fvgDirs = array.new<int>()

float atr14 = ta.atr(14)
float minGap = atr14 * fvgMin / 100

if showFvg
    int n = array.size(fvgBoxes)
    if n > 0
        for i = n - 1 to 0
            box bx = array.get(fvgBoxes, i)
            int dd = array.get(fvgDirs, i)
            bool filled = dd == 1 ? low <= box.get_bottom(bx) : high >= box.get_top(bx)
            if filled
                box.delete(bx)
                array.remove(fvgBoxes, i)
                array.remove(fvgDirs, i)
    if bar_index >= 2
        if low > high[2] and (low - high[2]) >= minGap
            array.push(fvgBoxes, box.new(bar_index - 2, low, bar_index, high[2], border_color = na, bgcolor = fvgBull, extend = extend.right))
            array.push(fvgDirs, 1)
        else if high < low[2] and (low[2] - high) >= minGap
            array.push(fvgBoxes, box.new(bar_index - 2, low[2], bar_index, high, border_color = na, bgcolor = fvgBear, extend = extend.right))
            array.push(fvgDirs, -1)
    if array.size(fvgBoxes) > fvgMax
        box oldest = array.shift(fvgBoxes)
        box.delete(oldest)
        array.shift(fvgDirs)

// =====================================================================
// DASHBOARD
// =====================================================================
fillRow(Setup s, table t, int r, bool isOn, bool isValid, string tf) =>
    string status = "Waiting"
    if not isOn
        status := "Off"
    else if not isValid
        status := "Open <= " + tfName(tf)
    else if s.dir == 1
        status := s.hit1 ? "BULL TP1 ok" : "BULL"
    else if s.dir == -1
        status := s.hit1 ? "BEAR TP1 ok" : "BEAR"
    string rate1 = s.nSig > 0 ? str.tostring(100.0 * s.nTp1 / s.nSig, "#") + "% (" + str.tostring(s.nSig) + ")" : "-"
    string rate2 = s.nSig > 0 ? str.tostring(100.0 * s.nTp2 / s.nSig, "#") + "%" : "-"
    table.cell(t, 0, r, tfName(tf), text_color = color.white, text_size = size.small)
    table.cell(t, 1, r, status, text_color = color.white, text_size = size.small)
    table.cell(t, 2, r, s.lastRes, text_color = color.white, text_size = size.small)
    table.cell(t, 3, r, rate1, text_color = color.white, text_size = size.small)
    table.cell(t, 4, r, rate2, text_color = color.white, text_size = size.small)
    true

var table tbl = table.new(position.top_right, 5, 4, bgcolor = color.new(color.black, 20), border_width = 1)
if showTable and barstate.islast
    table.cell(tbl, 0, 0, "TF", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 1, 0, "Status", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 2, 0, "Last", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 3, 0, "TP1 (n)", text_color = color.silver, text_size = size.small)
    table.cell(tbl, 4, 0, "TP2", text_color = color.silver, text_size = size.small)
    fillRow(s1, tbl, 1, on1, valid1, tf1)
    fillRow(s2, tbl, 2, on2, valid2, tf2)
    fillRow(s3, tbl, 3, on3, valid3, tf3)
